root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.go]
indent_style = tab

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# A verbatim copy of musher-dev/development-container's canonical script, which
# is formatted there and must stay byte-identical to it, so shfmt leaves it as
# it is (`--apply-ignore` in Taskfile.yml). ShellCheck still scans it.
[.devcontainer/scripts/lib/github-auth.sh]
ignore = true
